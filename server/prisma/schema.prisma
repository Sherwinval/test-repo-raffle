generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id          String   @id @default(uuid())
  employeeId  String?  @unique
  email       String   @unique
  role        String?
  site        String?
  firstName   String?
  lastName    String?
  rawData     Json?
  createdAt   DateTime @default(now())
}
