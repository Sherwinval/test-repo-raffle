generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id          String   @id @default(uuid())
  employeeId  String?
  email       String
  role        String?
  site        String?
  firstName   String?
  lastName    String?
  rawData     Json?
  createdAt   DateTime @default(now())
}

model Event {
  id        String        @id @default(uuid())
  name      String
  createdAt DateTime      @default(now())
  entries   Entry[]
  batches   UploadBatch[]
  auditLogs AuditLog[]
}

model UploadBatch {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  status       String
  totalRows    Int      @default(0)
  insertedRows Int      @default(0)
  skippedRows  Int      @default(0)
  errors       Json?
  createdAt    DateTime @default(now())
  entries      Entry[]
}

model Entry {
  id            String      @id @default(uuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  employeeId    String
  fullName      String
  department    String
  email         String
  entryCode     String
  uploadBatchId String
  batch         UploadBatch @relation(fields: [uploadBatchId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([eventId, entryCode])
}

model AuditLog {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action     String
  operator   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}
