generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id          String   @id @default(uuid())
  employeeId  String?
  email       String
  role        String?
  site        String?
  firstName   String?
  lastName    String?
  rawData     Json?
  createdAt   DateTime @default(now())
}
